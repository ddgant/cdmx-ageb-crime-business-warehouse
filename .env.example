# 127.0.0.1 instead of localhost: on Windows "localhost" can resolve to ::1 and reach a different PostgreSQL.
PGHOST=127.0.0.1
# Change the port if 5432 is already used by another PostgreSQL (docker-compose.yml reads this value too).
PGPORT=5432
PGDATABASE=cdmx_dw
PGUSER=postgres
PGPASSWORD=postgres
